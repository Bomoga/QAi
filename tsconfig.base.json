{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Relative imports carry an explicit `.ts` extension repo wide. Every project here
    // sets `noEmit` and is bundled by tsup, so no `.ts` specifier survives into output.
    "allowImportingTsExtensions": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // tsup's declaration build injects `baseUrl`, which TS 6 deprecates. Our own
    // configs never set it. Remove this once tsup stops injecting it.
    "ignoreDeprecations": "6.0",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
