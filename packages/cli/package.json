{
  "name": "@qai/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Command parsing, config resolution, terminal output, process exit.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "qai": "./bin/qai.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@qai/core": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  }
}
