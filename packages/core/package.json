{
  "name": "@qai/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schemas, loading, probing, checking, diffing, run assembly, emitters, storage.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate:schema": "node --experimental-strip-types scripts/generate-schema.ts",
    "validate:fixture": "node --experimental-strip-types scripts/validate-fixture-spec.ts"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "undici": "^8.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
