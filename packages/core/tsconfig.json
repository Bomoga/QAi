{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir or outDir: this config typechecks only, and tsup owns the build.
    // Pinning rootDir to src would reject the schema generator under scripts/.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
